{
  "name": "@feature-today/website",
  "version": "0.0.0",
  "description": "Marketing landing page for feature-today (Qwik 2 + Vercel Edge).",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feature-today/website.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "vite build -c adapters/vercel-edge/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "preview": "qwik build preview && vite preview --open",
    "start": "vite --open --mode ssr",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint.fix": "oxlint --fix",
    "fmt": "oxlint --fix",
    "fmt.check": "oxlint",
    "test": "vitest run --passWithNoTests",
    "test.watch": "vitest",
    "test.coverage": "vitest run --coverage --passWithNoTests",
    "qwik": "qwik"
  },
  "dependencies": {
    "@feature-today/common": "link:../common"
  },
  "devDependencies": {
    "@qwik.dev/core": "2.0.0-beta.35",
    "@qwik.dev/router": "2.0.0-beta.35",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "oxlint": "^1.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@11.4.0"
}